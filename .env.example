# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# Never commit .env to GitHub — it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Groq LLM (required for AI evaluation) ────────────────────────────────────
# Get keys at: console.groq.com
# Provide at least 2 keys, comma-separated — the pipeline rotates between them
# on rate-limit (429) so 10+ candidates can be evaluated without interruption.
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2

# ── GitHub (required for GitHub profile analysis) ────────────────────────────
# Get token at: github.com → Settings → Developer settings → Personal access tokens
# Scopes needed: public_repo (read-only is enough)
# Without this, you will hit the 60 req/hour unauthenticated limit for 10+ candidates.
GITHUB_TOKEN=ghp_your_github_token_here

# ── Gmail SMTP (for sending test-link emails to shortlisted candidates) ───────
# Use your Gmail address and an App Password (NOT your login password).
# How to create an App Password:
#   1. myaccount.google.com → Security → 2-Step Verification → turn ON
#   2. Security → search "App Passwords" → create one → copy the 16-char code
SMTP_USER=your_gmail@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Google Calendar OAuth (for scheduling interviews) ─────────────────────────
# These come from your Google Cloud project OAuth 2.0 credentials.
# Steps:
#   1. console.cloud.google.com → APIs & Services → Credentials
#   2. Create OAuth 2.0 Client ID (Desktop app type)
#   3. Download credentials.json → run: python refresh_google_token.py
#   4. Copy the printed values below
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret
GOOGLE_REFRESH_TOKEN=1//your_refresh_token
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
